# Frontend (Next.js) — variables públicas, seguras de exponer en el navegador.
# La anon key solo permite lo que las políticas RLS de Supabase autoricen
# (en este proyecto: SELECT sobre mldc_pipeline_logs, nada sobre mldc_companies).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-de-supabase>

# Backend server-side (Next.js API Routes, ej. app/api/bridge-engine) y
# pipeline Python (pipelines/servel_ingestion.py) — NUNCA exponer en el
# frontend/navegador. Estas variables NO llevan prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-de-supabase>

# El pipeline Python también puede usar su propio pipelines/.env con las
# mismas dos variables (ver pipelines/README.md).
