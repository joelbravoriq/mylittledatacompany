# Frontend (Next.js) — variables públicas, seguras de exponer en el navegador.
# La anon key solo permite lo que las políticas RLS de Supabase autoricen
# (en este proyecto: SELECT sobre mldc_pipeline_logs, nada sobre mldc_companies).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-de-supabase>

# Pipeline Python (pipelines/servel_ingestion.py) — NUNCA exponer en el frontend.
# Colocar en pipelines/.env (también ignorado por git), no en este archivo.
# SUPABASE_URL=https://<tu-proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key-de-supabase>
